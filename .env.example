# Server configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=super-secret-jwt-key-replace-me

# PostgreSQL configuration
# For Render / Neon / Supabase, set DATABASE_URL (takes priority over individual DB_* fields)
# DATABASE_URL=postgres://username:password@hostname:5432/dbname?sslmode=require

# Local PostgreSQL fallback settings (if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appixo_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# Optional: Default Dummy Admin Credentials
# If not specified, defaults to admin / admin123
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@appixo.com
DEFAULT_ADMIN_NAME=Administrator
